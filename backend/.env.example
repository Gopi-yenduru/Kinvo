# OpenAI Realtime API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (for SQL Server/MSSQL)
# Note: Database connection is configured in src/dbConfig.ts
# The application now uses SQL Server instead of SQLite

# Security (for production)
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here

# Optional: For healthcare compliance logging
AUDIT_LOG_ENABLED=true
HOSPITAL_SYSTEM_ID=medical_intake_poc