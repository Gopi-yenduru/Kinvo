# AI Provider Configuration
# Supported values: openai, retellai
AI_PROVIDER=openai

# OpenAI Realtime API Configuration
OPENAI_API_KEY=sk-your-openai-api-key

SARVAM_API_KEY=your-sarvam-api-key

# Voice-agent TTS engine per language (optional override; restart to apply).
# Each = 'sarvam' (best native pronunciation) or 'openai' (more emotional, needs OPENAI_API_KEY).
# Defaults if unset: te-IN=sarvam, hi-IN=openai, en-IN=openai.
# To A/B Telugu emotion by ear, set TTS_ENGINE_TE=openai (falls back to Sarvam if no OpenAI key).
TTS_ENGINE_TE=sarvam
TTS_ENGINE_HI=openai
TTS_ENGINE_EN=openai

# Sarvam voice A/B (optional; restart to apply). Override the TTS speaker per language without
# touching Settings. Bulbul v3 voices (neha, priya, kavya, simran, ritu…) are more natural and
# express emotion through the text + pace; v2 voices (anushka…) also obey pitch/loudness.
# Example — try the warm v3 Telugu voice:
# TTS_SPEAKER_TE=neha
# TTS_SPEAKER_HI=
# TTS_SPEAKER_EN=

# EXPERIMENTAL (optional): expressive variation for v3 voices via bulbul:v3-beta `temperature`
# (0.01–1.0). Only applies when the resolved speaker is a v3 voice. Remove it if TTS errors.
# SARVAM_TTS_TEMPERATURE=0.7

# Filler audio (optional): short pre-generated acknowledgment clips ("ఊఁ...", "సరే...") in the
# agent's own voice, played when the real reply's audio hasn't started FILLER_DELAY_MS after the
# patient stops talking — covers LLM thinking time so there is never dead air. On by default.
# SARVAM_FILLERS=off
# FILLER_DELAY_MS=350

# ── VANI humanization A/B flags (each independently toggleable; restart to apply) ──────────
# Audio/timing layers default ON. The in-house engine's PROMPT is a copy of the LiveKit
# engine's (it tested most natural); the old experimental prompt blocks were removed.
# VANI_TIMING_JITTER=off   # upgrade 4: per-turn sampled response gap (350–800ms, never repeats)
# VANI_PACE_JITTER=off     # upgrade 2: TTS pace wobble ±0.03/turn (kills the melody loop)
# VANI_BREATHS=off         # upgrade 3: quiet inhale before long replies (max 1 per 2 turns)
# VANI_NOISE_BED=off       # upgrade 3: continuous −42 dBFS room tone in the browser
# VANI_TELEPHONY_EQ=on     # upgrade 3: 300–3400 Hz band-pass + compression (default OFF —
#                          #   simulates a phone line; hurts a hi-fi browser voice)

# Voice clone + bake-off (upgrades 1 & 6): see docs/recording_brief.md, then
#   node scripts/clone-voice.mjs --file voice_sample.wav --engine elevenlabs --test
#   node scripts/naturalness-bakeoff.mjs [--telephony]
# BAKEOFF_SARVAM_VOICE=neha
# BAKEOFF_SARVAM_ALT=priya

# ElevenLabs voice (optional, most emotionally expressive). To use it for a language, set the key +
# a voice id, then route that language with TTS_ENGINE_*=elevenlabs (e.g. TTS_ENGINE_TE=elevenlabs).
# Model tradeoff (all support Telugu):
#   eleven_multilingual_v2 = rich emotion + usable latency (default, best for live conversation)
#   eleven_v3             = MAX/dramatic emotion but higher latency (longer pause before each reply)
#   eleven_flash_v2_5     = fastest, least emotional
# Find/duplicate a voice in your ElevenLabs Voice Library and copy its Voice ID.
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_TE=your-telugu-voice-id
# ELEVENLABS_VOICE_HI=your-hindi-voice-id
# ELEVENLABS_VOICE_EN=your-english-voice-id
# ELEVENLABS_VOICE_ID=fallback-voice-id-for-any-language-not-set-above

# Pipecat open-source voice pipeline (optional). Where the Python service from
# pipecat-service/ is listening; used when the "Pipecat (open source)" voice engine is
# selected on the Dashboard/Settings. Start it with: cd pipecat-service && python main.py
PIPECAT_URL=http://localhost:8765

# LiveKit Agents + Chatterbox-Turbo voice pipeline (optional). Where the Python service from
# livekit-service/ is listening; used when the "LiveKit Agents + Chatterbox-Turbo" voice
# engine is selected on the Dashboard/Settings. Start it with: cd livekit-service && python main.py
# (The livekit-service itself needs CHATTERBOX_URL pointing at a Chatterbox TTS server for
# the English voice — see livekit-service/.env.example.)
LIVEKIT_URL=http://localhost:8766

# Server Configuration
PORT=3001
NODE_ENV=development

# VAPI Configuration
VAPI_API_KEY=your-vapi-api-key
VAPI_ASSISTANT_ID=your-vapi-assistant-id

#RetellAI Configuration
RETELLAI_API_KEY=your-retellai-api-key
RETELLAI_AGENT_ID=your-retellai-agent-id

# Database Configuration for Azure SQL
DB_SERVER=your-db-server.database.windows.net
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_PORT=1433

# Security (for production) — use long random strings, NOT these placeholders
SESSION_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string

# Optional: For healthcare compliance logging
AUDIT_LOG_ENABLED=true
HOSPITAL_SYSTEM_ID=medical_intake_poc
