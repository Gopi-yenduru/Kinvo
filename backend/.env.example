# AI Provider Configuration
# Supported values: openai, retellai
AI_PROVIDER=openai

# OpenAI Realtime API Configuration
OPENAI_API_KEY=sk-your-openai-api-key

SARVAM_API_KEY=your-sarvam-api-key

# Voice-agent TTS engine per language (optional override; restart to apply).
# Each = 'sarvam' (best native pronunciation) or 'openai' (more emotional, needs OPENAI_API_KEY).
# Defaults if unset: te-IN=sarvam, hi-IN=openai, en-IN=openai.
# To A/B Telugu emotion by ear, set TTS_ENGINE_TE=openai (falls back to Sarvam if no OpenAI key).
TTS_ENGINE_TE=sarvam
TTS_ENGINE_HI=openai
TTS_ENGINE_EN=openai

# Sarvam voice A/B (optional; restart to apply). Override the TTS speaker per language without
# touching Settings. Bulbul v3 voices (neha, priya, kavya, simran, ritu…) are more natural and
# express emotion through the text + pace; v2 voices (anushka…) also obey pitch/loudness.
# Example — try the warm v3 Telugu voice:
# TTS_SPEAKER_TE=neha
# TTS_SPEAKER_HI=
# TTS_SPEAKER_EN=

# EXPERIMENTAL (optional): expressive variation for v3 voices via bulbul:v3-beta `temperature`
# (0.01–1.0). Only applies when the resolved speaker is a v3 voice. Remove it if TTS errors.
# SARVAM_TTS_TEMPERATURE=0.7

# ElevenLabs voice (optional, most emotionally expressive). To use it for a language, set the key +
# a voice id, then route that language with TTS_ENGINE_*=elevenlabs (e.g. TTS_ENGINE_TE=elevenlabs).
# Model tradeoff (all support Telugu):
#   eleven_multilingual_v2 = rich emotion + usable latency (default, best for live conversation)
#   eleven_v3             = MAX/dramatic emotion but higher latency (longer pause before each reply)
#   eleven_flash_v2_5     = fastest, least emotional
# Find/duplicate a voice in your ElevenLabs Voice Library and copy its Voice ID.
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_TE=your-telugu-voice-id
# ELEVENLABS_VOICE_HI=your-hindi-voice-id
# ELEVENLABS_VOICE_EN=your-english-voice-id
# ELEVENLABS_VOICE_ID=fallback-voice-id-for-any-language-not-set-above

# Server Configuration
PORT=3001
NODE_ENV=development

# VAPI Configuration
VAPI_API_KEY=your-vapi-api-key
VAPI_ASSISTANT_ID=your-vapi-assistant-id

#RetellAI Configuration
RETELLAI_API_KEY=your-retellai-api-key
RETELLAI_AGENT_ID=your-retellai-agent-id

# Database Configuration for Azure SQL
DB_SERVER=your-db-server.database.windows.net
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_PORT=1433

# Security (for production) — use long random strings, NOT these placeholders
SESSION_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string

# Optional: For healthcare compliance logging
AUDIT_LOG_ENABLED=true
HOSPITAL_SYSTEM_ID=medical_intake_poc
