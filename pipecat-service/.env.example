# Copy to .env and fill in. The Node backend reuses these same keys.
OPENAI_API_KEY=
SARVAM_API_KEY=

# Port the service listens on (Node backend's PIPECAT_URL must point here).
PORT=8765
HOST=0.0.0.0

# ── Optional engine overrides ────────────────────────────────────────────────
# LLM engine for Telugu/Hindi sessions: openai (default, gpt-4o — most reliable)
# or sarvam (Sarvam's OpenAI-compatible chat API).  English always uses OpenAI.
# PIPECAT_LLM_ENGINE=openai
# OPENAI_LLM_MODEL=gpt-4o        # set gpt-4o-mini for lower latency (slightly weaker Indic)
# SARVAM_CHAT_MODEL=sarvam-m
# OPENAI_STT_MODEL=gpt-4o-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_TTS_MODEL=bulbul:v3

# ── Turn-taking / latency ────────────────────────────────────────────────────
# By default a fast VAD-silence timer decides when the patient has finished speaking.
# PIPECAT_TURN_STOP_SECS=0.6    # silence after speech before the agent replies (lower = snappier)
# PIPECAT_SMART_TURN=1          # restore pipecat's slower ML "Smart Turn" end-of-turn detector
# PIPECAT_EN_STT=sarvam         # English STT: sarvam (default, reliable here) or openai

# ── Debug ────────────────────────────────────────────────────────────────────
# PIPECAT_DEBUG_AUDIO=1         # log inbound mic-audio frame counts
# PIPECAT_DEBUG_FRAMES=1        # log pipeline frame types (turn/VAD diagnostics)
