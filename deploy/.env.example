# Copy to deploy/.env and fill in real values. NEVER commit deploy/.env.

# Public URL patients/staff use (must match the TLS cert host). Used for CORS.
PUBLIC_URL=https://intake.hospital.local

# Postgres
PGDATABASE=medintake
PGUSER=medintake
PGPASSWORD=change_me_strong_password

# Auth — generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=replace_with_64_hex_chars_minimum_32
JWT_EXPIRES_IN=12h
ADMIN_PASSWORD=change_me_admin_password

# Sarvam AI (voice pipeline). A Data Processing Agreement with Sarvam is required
# because patient voice/transcripts (PHI) are processed by Sarvam's cloud API.
SARVAM_API_KEY=your_sarvam_api_subscription_key

# OpenAI (English voice stages + Pipecat/LiveKit pipeline LLM). Same PHI caveat applies.
OPENAI_API_KEY=your_openai_api_key

# Chatterbox-Turbo TTS server for the LiveKit voice engine's English voice. Only needed if
# staff select the "LiveKit Agents + Chatterbox-Turbo" engine. Point at a running
# Chatterbox-TTS-Server (see deploy/docker-compose.prod.yml — the commented `chatterbox`
# service, or an external GPU box). Defaults to the in-compose service if left unset.
# CHATTERBOX_URL=http://chatterbox:8004
# CHATTERBOX_MODEL=chatterbox-turbo
# CHATTERBOX_VOICE=default

# Field-level PHI encryption key (AES-256-GCM). openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_hex_chars
