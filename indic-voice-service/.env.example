# Copy to .env. No API keys needed — these are local open models (weights download from
# HuggingFace on first use).

PORT=8005
HOST=0.0.0.0

# Device: auto (CUDA if available, else CPU) | cpu | cuda
INDIC_DEVICE=auto

# ── Model overrides (optional) ───────────────────────────────────────────────
# INDIC_CONFORMER_MODEL=ai4bharat/indic-conformer-600m-multilingual
# INDIC_CONFORMER_DECODING=ctc          # ctc (fast) or rnnt
# INDIC_PARLER_MODEL=ai4bharat/indic-parler-tts
# INDIC_PARLER_DESCRIPTION=              # full Parler voice description (overrides the default)
# IndicWhisper checkpoints per language:
# INDIC_WHISPER_TE=vasista22/whisper-telugu-medium
# INDIC_WHISPER_HI=vasista22/whisper-hindi-medium
