# Copy to .env and fill in. The Node backend reuses OPENAI_API_KEY / SARVAM_API_KEY.
OPENAI_API_KEY=
SARVAM_API_KEY=

# Chatterbox-Turbo TTS server (English voice). Point this at a running
# Chatterbox-TTS-Server (https://github.com/devnen/Chatterbox-TTS-Server) with the
# "chatterbox-turbo" model selected. Give the base URL WITH or WITHOUT the /v1 suffix.
CHATTERBOX_URL=http://localhost:8004
# A predefined voice filename served by the Chatterbox server (see its voices/ dir), e.g.
# Emily.wav / Alice.wav. The OpenAI-compatible endpoint resolves `voice` to a real file, so
# an OpenAI name like "alloy" will 404.
CHATTERBOX_VOICE=Emily.wav
CHATTERBOX_MODEL=chatterbox-turbo

# Port the service listens on (Node backend's LIVEKIT_URL must point here).
PORT=8766
HOST=0.0.0.0

# ── Optional engine overrides ────────────────────────────────────────────────
# English TTS engine: chatterbox (Chatterbox-Turbo; auto-falls back to OpenAI if the server is
# unreachable) or openai (fast OpenAI TTS, no GPU). Chatterbox on CPU is very slow (~1-2 min per
# sentence) — use openai unless the Chatterbox server runs on a GPU.
# LIVEKIT_EN_TTS=chatterbox
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# OPENAI_TTS_INSTRUCTIONS steer the English delivery (warm/natural). Defaults to a caring-nurse
# style; set to override the tone.
# OPENAI_TTS_INSTRUCTIONS=Speak warmly and naturally, like a caring nurse.

# ── Natural voice tuning (Telugu/Hindi via Sarvam Bulbul) ────────────────────
# Make the voice sound unhurried and human. pace<1 slows it down; a little temperature adds
# lifelike variation. On bulbul:v3 the API ignores pitch/loudness, so pace+temperature carry the
# feel. Tune these by ear.
# SARVAM_TTS_MODEL=bulbul:v3       # newest, most natural Bulbul model
# SARVAM_TTS_PACE=0.9             # 0.3–3.0 (lower = slower, calmer)
# SARVAM_TTS_TEMPERATURE=0.7      # 0.01–2.0 (higher = more expressive/varied)

# ── Turn-taking: let the patient pause and CONTINUE ──────────────────────────
# Seconds of silence before the agent decides the patient is done and replies. Silero's default
# (0.55) cuts in on brief mid-thought pauses; raise it so a patient can pause and keep talking.
# LIVEKIT_VAD_SILENCE=0.9         # 0.3–3.0 (higher = waits longer, more room to continue)
# LLM for every language (OpenAI chat completions with the intake tools).
# LIVEKIT_LLM_MODEL=gpt-4o        # gpt-4o-mini for lower latency (slightly weaker Indic)
# English STT: sarvam (default, reliable here) or openai.
# LIVEKIT_EN_STT=sarvam
# OPENAI_STT_MODEL=gpt-4o-transcribe

# Open Indic STT/TTS service (Telugu/Hindi). Used when Settings routes te/hi STT to
# IndicConformer/IndicWhisper or TTS to Indic Parler-TTS; Sarvam is the default + fallback.
INDIC_VOICE_URL=http://localhost:8005
